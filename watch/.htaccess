# ====== watch.gokyo.lu : cadrans de montre édités par GOKYO ======
# Ce dossier est la racine du sous-domaine watch.gokyo.lu.
ErrorDocument 404 /404.html
AddType font/woff2 .woff2
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Une seule adresse : gokyo.lu/watch/... -> watch.gokyo.lu/...
  RewriteCond %{HTTP_HOST} ^(www\.)?gokyo\.lu$ [NC]
  RewriteRule ^(.*)$ https://watch.gokyo.lu/$1 [R=301,L]
  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  # Accueil provisoire : le seul cadran publié
  RewriteRule ^$ /crosswind/ [R=302,L]
  # Crosswind METAR : QR code de la montre -> page des réglages avec le code
  RewriteRule ^[Aa]/([0-9]{6})/?$ /crosswind/?c=$1 [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  # pages : revérifiées à chaque visite, une page publiée est vue tout de suite
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
